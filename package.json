{
  "name": "breachguard",
  "version": "0.4.0",
  "private": true,
  "description": "Privacy-conscious breach exposure checker (web, PWA, Android via Capacitor)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "python3 scripts/gen_icons.py",
    "pretest": "python3 scripts/gen_icons.py --if-missing",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "build": "node scripts/lint.mjs",
    "serve": "node scripts/serve.mjs",
    "audit": "npm audit --audit-level=high",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:harden": "python3 scripts/android_harden.py android",
    "android:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.0"
  }
}
